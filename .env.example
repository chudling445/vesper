# Vesper listens only on this computer. The default chat engine is local Ollama.
DEFAULT_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Online launch only: set a unique random password (at least 32 characters) before exposing Vesper.
# Keep it private. The server stores only a signed, HTTP-only browser session cookie.
VESPER_ACCESS_PASSWORD=
# Set these in your hosting provider, not in a public source repository.
# HOST=0.0.0.0
# PORT=3174
# NODE_ENV=production
# VESPER_PUBLIC_MODE=true
# VESPER_TRUST_PROXY=true

# Optional OpenAI API settings. Keep the key private in this file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional OpenAI-compatible service. Set the base URL, model, and key if needed.
COMPAT_LLM_BASE_URL=
COMPAT_LLM_API_KEY=
COMPAT_LLM_MODEL=local-model
